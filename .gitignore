# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Build output
build/
bin/
.sconsign.dblite
*.os
*.obj
*.o
*.a
*.lib
*.so
*.dll
*.dylib
*.pdb
*.exp
compile_commands.json

# Python
__pycache__/
*.pyc
.venv/

# Godot must not import third-party sources or build output
third_party/**/*.import
